# Clave de Gemini API (requerida en el servidor para analizar PDF, Word y texto)
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# Puerto HTTP del servidor Express (por defecto 3000)
PORT="3000"

# Entorno de ejecución ("development" o "production")
NODE_ENV="development"

# URL pública donde se despliega la aplicación (opcional)
APP_URL="http://localhost:3000"
